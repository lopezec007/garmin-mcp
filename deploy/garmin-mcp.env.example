# Configuration for the garmin-mcp service.
#
# Installed as /etc/garmin-mcp/garmin-mcp.env (root:garmin-mcp, mode 0640) on the
# first run of install.sh and never overwritten afterwards. Apply changes with:
#
#     sudo systemctl restart garmin-mcp
#
# Format: this is a systemd EnvironmentFile, not a shell script.
#   * One NAME=value per line. Lines starting with # or ; are comments; there
#     are no trailing comments (a # after a value is part of the value).
#   * Nothing is expanded: $VAR and $(cmd) are taken literally.
#   * Unquoted values lose leading/trailing whitespace, and a backslash escapes
#     the next character (so a literal backslash must be written as \\).
#   * For a value with special characters, put it in single quotes: everything
#     between them is taken verbatim.        GARMIN_PASSWORD='p@ss #1 $x\y"z'
#   * A value that itself contains a single quote goes in double quotes, with
#     a backslash before each  "  \  $  and backtick.  GARMIN_PASSWORD="it's \$5"
# Every variable is optional; a commented-out line shows the default.


# --- Garmin account ---------------------------------------------------------
#
# The service needs either saved tokens or credentials. Pick one:
#
#   A. Log in once, store no password (recommended; required if the account
#      uses MFA, because the service cannot answer the MFA prompt):
#
#          sudo garmin-mcp login
#
#      This asks for email, password and MFA code, then saves refreshable
#      tokens to /var/lib/garmin-mcp/tokens. Leave both variables below unset.
#
#   B. Set email and password here. The service logs in by itself, and logs in
#      again without you if the saved tokens ever stop working. The password
#      then sits in this file in clear text. Not possible for accounts with
#      MFA: those always need the interactive login from A.
#
#GARMIN_EMAIL=you@example.com
#GARMIN_PASSWORD='your password'

# Set to true for accounts on Garmin's China region (garmin.cn).
#GARMIN_IS_CN=false

# Where tokens are stored. Leave unset: under systemd it defaults to
# /var/lib/garmin-mcp/tokens, the only directory the sandboxed service can
# write to. (A different path also needs ReadWritePaths= in a unit drop-in.)
#GARMIN_TOKEN_DIR=/var/lib/garmin-mcp/tokens

# Seconds to wait after a failed Garmin login before trying again, so that a
# wrong password or a rate limit does not turn into repeated login attempts.
# Restarting the service clears the wait.
#GARMIN_MCP_LOGIN_COOLDOWN=300


# --- Access control ---------------------------------------------------------
#
# Shared secret. When set, every MCP request must carry the header
#     Authorization: Bearer <token>
# (GET /healthz stays open). Without it, anyone who can reach the port can read
# this account's health data, so set it. Generate a value with either of:
#
#     openssl rand -hex 32
#     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# install.sh fills this in with a random token when it first creates this file.
#GARMIN_MCP_AUTH_TOKEN=

# Optional allowlist for the HTTP Host header (protects against DNS rebinding).
# Comma-separated, each entry "host:port" or "host:*", naming every address or
# name that clients use in the URL. Empty accepts any Host. When set, requests
# that carry an Origin header (sent by browsers) are rejected as well.
#GARMIN_MCP_ALLOWED_HOSTS=192.168.1.10:*,garmin.lan:*


# --- HTTP listener ----------------------------------------------------------
#
# Address to bind. 0.0.0.0 listens on every IPv4 interface; use one LAN
# address to restrict it, or 127.0.0.1 when a reverse proxy on this host is
# the only client.
#GARMIN_MCP_HOST=0.0.0.0

# TCP port. Ports below 1024 need extra privileges the unit does not grant.
#GARMIN_MCP_PORT=8765

# URL path of the MCP endpoint: clients connect to http://<host>:<port><path>.
#GARMIN_MCP_PATH=/mcp


# --- Logging ----------------------------------------------------------------
#
# DEBUG, INFO, WARNING or ERROR. DEBUG also logs every HTTP request.
# Read the log with: journalctl -u garmin-mcp
#GARMIN_MCP_LOG_LEVEL=INFO

# Configuration for the garmin-mcp service.
#
# Installed as /etc/garmin-mcp/garmin-mcp.env (root:garmin-mcp, mode 0640) on the
# first run of install.sh and never overwritten afterwards. Apply changes with:
#
#     sudo systemctl restart garmin-mcp
#
# Format: this is a systemd EnvironmentFile, not a shell script.
#   * One NAME=value per line. Lines starting with # or ; are comments; there
#     are no trailing comments (a # after a value is part of the value).
#   * Nothing is expanded: $VAR and $(cmd) are taken literally.
#   * Unquoted values lose leading/trailing whitespace, and a backslash escapes
#     the next character (so a literal backslash must be written as \\).
#   * For a value with special characters, put it in single quotes: everything
#     between them is taken verbatim.        GARMIN_PASSWORD='p@ss #1 $x\y"z'
#   * A value that itself contains a single quote goes in double quotes, with
#     a backslash before each  "  \  $  and backtick.  GARMIN_PASSWORD="it's \$5"
# Every variable is optional; a commented-out line shows the default.


# --- Garmin account ---------------------------------------------------------
#
# The service needs either saved tokens or credentials. Pick one:
#
#   A. Log in once, store no password (recommended; required if the account
#      uses MFA, because the service cannot answer the MFA prompt):
#
#          sudo garmin-mcp login
#
#      This asks for email, password and MFA code, then saves refreshable
#      tokens to /var/lib/garmin-mcp/tokens. Leave both variables below unset.
#
#   B. Set email and password here. The service logs in by itself, and logs in
#      again without you if the saved tokens ever stop working. The password
#      then sits in this file in clear text. Not possible for accounts with
#      MFA: those always need the interactive login from A.
#
#GARMIN_EMAIL=you@example.com
#GARMIN_PASSWORD='your password'

# Set to true for accounts on Garmin's China region (garmin.cn).
#GARMIN_IS_CN=false

# Where tokens are stored. Leave unset: under systemd it defaults to
# /var/lib/garmin-mcp/tokens, the only directory the sandboxed service can
# write to. (A different path also needs ReadWritePaths= in a unit drop-in.)
#GARMIN_TOKEN_DIR=/var/lib/garmin-mcp/tokens

# Seconds to wait after a failed Garmin login before trying again, so that a
# wrong password or a rate limit does not turn into repeated login attempts.
# Restarting the service clears the wait.
#GARMIN_MCP_LOGIN_COOLDOWN=300


# --- Access control ---------------------------------------------------------
#
# Shared secret. When set, an MCP request that carries the header
#     Authorization: Bearer <token>
# is let in (GET /healthz is always open). Generate a value with either of:
#
#     openssl rand -hex 32
#     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# install.sh fills this in with a random token when it first creates this file.
#
# Without GARMIN_MCP_PUBLIC_URL (below) this is the only protection: leave it
# unset and anyone who can reach the port can read this account's health data.
# With GARMIN_MCP_PUBLIC_URL set, the token keeps working next to OAuth, on the
# public URL too, and never expires: handy for LAN clients and scripts that
# send a header instead of signing in. Comment it out then to make OAuth the
# only way in.
#GARMIN_MCP_AUTH_TOKEN=

# Optional allowlist for the HTTP Host header on the MCP endpoint (protects
# against DNS rebinding). Comma-separated, naming every address or name that
# clients use in the URL. Empty accepts any Host. An entry is "host:port",
# "host:*" (any port, but the Host header must have one), or a bare "host" for
# a name that clients reach on the default port: the public name behind a TLS
# proxy arrives as "garmin.example.com", which "garmin.example.com:*" does not
# match. When set, requests that carry an Origin header (sent by browsers) are
# rejected as well.
#GARMIN_MCP_ALLOWED_HOSTS=192.168.1.10:*,garmin.lan:*,garmin.example.com


# --- Public access with OAuth -----------------------------------------------
#
# Leave this section as it is for a server that is only used on the LAN.
#
# To let MCP clients connect over the internet, put a TLS reverse proxy (or a
# tunnel that terminates TLS) in front of this server, which itself only
# speaks plain HTTP, and set GARMIN_MCP_PUBLIC_URL. The steps are in the
# README under "Public access with OAuth".
#
# The https origin the server is reachable at: scheme and host name, no path.
# Setting it turns on the built-in OAuth authorization server. Clients are then
# given just the URL https://garmin.example.com/mcp and each one has to be
# approved once in a browser with the owner password. That password is not
# kept in this file; set it with
#
#     sudo garmin-mcp set-password
#
# Must be https (http is accepted for localhost only, for testing). With a
# value that is not usable the service does not start; the log says why.
# Default: unset, OAuth off.
#GARMIN_MCP_PUBLIC_URL=https://garmin.example.com

# Reverse proxies whose X-Forwarded-For header is believed, as a
# comma-separated list of addresses or networks (10.0.0.0/8). The approval
# page limits password guesses per client address and takes that address from
# X-Forwarded-For, but only when the connection comes from one of these. The
# default fits a proxy on this machine. For a proxy on another machine, put
# its address here: otherwise all visitors count as one address and share one
# limit. Never list addresses that are not your proxy.
#GARMIN_MCP_TRUSTED_PROXIES=127.0.0.1

# Lifetime of OAuth tokens in seconds. An access token is what a client sends
# with each request (default 1 hour, minimum 60). A refresh token lets the
# client get the next one without a new approval and is replaced each time it
# is used (default 30 days), so a client stays signed in for as long as it
# connects at least once in that period.
#GARMIN_MCP_OAUTH_ACCESS_TTL=3600
#GARMIN_MCP_OAUTH_REFRESH_TTL=2592000

# SQLite database with the registered clients, the hashed tokens and the hash
# of the owner password. Leave unset: under systemd it defaults to
# /var/lib/garmin-mcp/oauth.db, inside the only directory the sandboxed
# service and the admin commands can write to.
#GARMIN_MCP_OAUTH_DB=/var/lib/garmin-mcp/oauth.db


# --- HTTP listener ----------------------------------------------------------
#
# Address to bind. 0.0.0.0 listens on every IPv4 interface; use one LAN
# address to restrict it, or 127.0.0.1 when everything arrives through a
# reverse proxy on this host (the usual choice with GARMIN_MCP_PUBLIC_URL,
# unless LAN clients still connect to the port directly).
#GARMIN_MCP_HOST=0.0.0.0

# TCP port. Ports below 1024 need extra privileges the unit does not grant.
#GARMIN_MCP_PORT=8765

# URL path of the MCP endpoint: clients connect to http://<host>:<port><path>,
# or to <GARMIN_MCP_PUBLIC_URL><path>.
#GARMIN_MCP_PATH=/mcp


# --- Logging ----------------------------------------------------------------
#
# DEBUG, INFO, WARNING or ERROR. DEBUG also logs every HTTP request.
# Read the log with: journalctl -u garmin-mcp
#GARMIN_MCP_LOG_LEVEL=INFO

# systemd unit for the Garmin Connect MCP server.
# Installed to /etc/systemd/system/garmin-mcp.service by install.sh.
# Local changes belong in a drop-in (`sudo systemctl edit garmin-mcp`), because
# install.sh overwrites this file on every upgrade.

[Unit]
Description=Garmin Connect MCP server (streamable HTTP)
# Garmin is only contacted lazily, but binding to a specific LAN address
# (GARMIN_MCP_HOST) needs that address to be configured first.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=garmin-mcp
Group=garmin-mcp
# Settings and secrets. Read by systemd (as root) before the process starts.
EnvironmentFile=/etc/garmin-mcp/garmin-mcp.env
ExecStart=/opt/garmin-mcp/venv/bin/garmin-mcp serve

# A crash is retried every 15 s, indefinitely: slow enough never to reach
# systemd's start limit (5 starts in 10 s), so the service recovers on its own
# once the cause (for example a bad value in the env file) is fixed.
Restart=on-failure
RestartSec=15

# /var/lib/garmin-mcp, owned by the service user. systemd exports it as
# $STATE_DIRECTORY and the app keeps its Garmin tokens in $STATE_DIRECTORY/tokens.
# It is the only path the service can write to besides its private /tmp.
StateDirectory=garmin-mcp
StateDirectoryMode=0700
UMask=0077

# --- Sandboxing -------------------------------------------------------------
# The service needs: outbound HTTPS, one unprivileged listening TCP port, and
# its state directory. Everything else is taken away.

# Privileges
NoNewPrivileges=yes
# Empty: no capabilities at all. A port below 1024 would need a drop-in with
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE and AmbientCapabilities=CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private

# File system
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes

# Network: IPv4/IPv6 for the listener and for Garmin. AF_UNIX stays allowed
# because, depending on /etc/nsswitch.conf, name resolution goes through a
# local socket (nss-resolve to systemd-resolved, nss-mdns to avahi).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System calls. These two groups are the ones that tend to break CPython with
# native extensions (here curl_cffi, cryptography, pydantic-core). Both were
# tested against this app: imports, DNS, HTTPS through curl_cffi and through
# requests, and the running server all work with them. If a dependency upgrade
# ever makes the service fail with an unexpected "Operation not permitted" or
# "Permission denied", switch these off first, in a drop-in
# (`sudo systemctl edit garmin-mcp`):
#     [Service]
#     MemoryDenyWriteExecute=no
#     SystemCallFilter=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
